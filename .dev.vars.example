# ==============================================================================
# ORBIT Payment Hub — Cloudflare Worker Local Development Secrets (.dev.vars)
# Copy this file to `.dev.vars` and fill in your credentials.
# NEVER commit `.dev.vars` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Platform & Auth
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PRODUCTION_DOMAIN=payment.orbitsaas.cloud
MASTER_ADMIN_KEY=orbit_master_admin_2026
ENCRYPTION_PEPPER=change-me-to-a-long-random-pepper
JWT_SECRET=change-me-to-a-long-random-jwt-secret

# ------------------------------------------------------------------------------
# OTP Verification Service
# ------------------------------------------------------------------------------
# Default OTP expiration in seconds (300 = 5 minutes)
OTP_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# Push Notifications — Firebase Cloud Messaging (FCM HTTP v1)
# ------------------------------------------------------------------------------
# Paste the full single-line JSON of your Firebase service account key.
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"}
# Optional override if project_id differs from the service account JSON:
# FCM_PROJECT_ID=your-firebase-project-id
# Deprecated (no longer used — legacy FCM endpoint was removed):
# FCM_SERVER_KEY=

# ------------------------------------------------------------------------------
# SMS Providers (Priority order: bulksmsbd -> ssl_wireless -> twilio -> custom_webhook)
# ------------------------------------------------------------------------------
SMS_PROVIDER_ORDER=bulksmsbd,ssl_wireless,twilio,custom_webhook

# BulkSMSBD (Bangladesh)
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# SSL Wireless (Bangladesh)
SSL_WIRELESS_API_TOKEN=
SSL_WIRELESS_SID=

# Twilio (International fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Custom SMS/Push Webhook fallback
CUSTOM_SMS_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Email Service Router
# ------------------------------------------------------------------------------
EMAIL_PROVIDER_ORDER=resend,brevo,sendpulse,aws_ses,sendgrid,cloudflare,apps_script,custom_webhook
EMAIL_FROM=no-reply@orbitsaas.cloud
EMAIL_FROM_NAME=ORBIT Payment Hub

RESEND_API_KEY=
BREVO_API_KEY=
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDGRID_API_KEY=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=ap-southeast-1
CLOUDFLARE_EMAIL_API_KEY=
MAILCHANNELS_API_KEY=
APPS_SCRIPT_EMAIL_URL=
CUSTOM_EMAIL_WEBHOOK_URL=
CUSTOM_EMAIL_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Image Storage Router
# ------------------------------------------------------------------------------
IMAGE_PROVIDER_ORDER=r2,imgbb,supabase,mongodb,d1
IMGBB_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=orbit-media
MONGODB_DATA_API_URL=
MONGODB_API_KEY=
MONGODB_DATABASE=orbit_pay

# ------------------------------------------------------------------------------
# Database Router (Optional secondary KV/cache providers)
# ------------------------------------------------------------------------------
DATABASE_PROVIDER_ORDER=d1,kv,supabase,mongodb,turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
