    <string name="onboarding_step1_title">1. Allow SMS Permissions</string>
    <string name="onboarding_step1_subtitle">Required to detect incoming bKash &amp; Nagad payments</string>
    <string name="onboarding_step1_desc">ORBIT Pay reads only official payment SMS from bKash, NAGAD, 16216, upay, and CellFin. Personal messages are never uploaded.</string>
    <string name="onboarding_step1_action">Allow SMS, Phone &amp; Notification Permissions</string>
    <string name="onboarding_step2_title">2. Notification Access</string>
    <string name="onboarding_step2_subtitle">Fast backup when mobile SMS is delayed</string>
    <string name="onboarding_step2_desc">If telecom SMS arrives late during busy hours, Notification Access lets ORBIT Pay confirm payments from bKash or Nagad app alerts.</string>
    <string name="onboarding_step2_action">Open notification access settings</string>
    <string name="onboarding_step3_title">3. Keep App Active in Background</string>
    <string name="onboarding_step3_subtitle">Stop Android from pausing payment checks</string>
    <string name="onboarding_step3_desc">Phone battery savers can put apps to sleep when the screen is off. Turning off battery restriction keeps payment verification active 24/7.</string>
    <string name="onboarding_step3_action">Allow unrestricted battery</string>
    <string name="onboarding_step4_title">4. Android 13/14/15 Restricted Settings</string>
    <string name="onboarding_step4_subtitle">Unlock settings if they appear greyed out</string>
    <string name="onboarding_step4_desc">On newer Android phones, Notification Access may be locked as a "Restricted setting".\n\nTo unlock:\n1. Tap "Open App Info" below\n2. Tap the 3 dots in the top-right corner\n3. Tap "Allow restricted settings"\n4. Confirm with your PIN or fingerprint.</string>
    <string name="onboarding_step4_action">Open App Info</string>
    <string name="onboarding_step5_title">5. Fake SMS Protection &amp; Ready</string>
    <string name="onboarding_step5_subtitle">How ORBIT Pay protects your business from fake messages</string>
    <string name="onboarding_step5_desc">Every payment alert is verified against official MFS sender rules before any order is marked Paid.</string>
    <string name="onboarding_step5_spoof_title">Official MFS senders only</string>
    <string name="onboarding_step5_spoof_desc">Only official bKash, NAGAD, 16216, Rocket, upay, CellFin, and IBBL alerts are accepted. Personal 01XXXXXXXXX SMS fakes are blocked automatically.</string>
    <string name="onboarding_step5_readsms_title">Missed Payment Recovery (72h)</string>
    <string name="onboarding_step5_readsms_desc">If your internet was off, ORBIT Pay safely checks the last 72 hours of official payment SMS to recover missed payments. Personal messages are never touched.</string>

