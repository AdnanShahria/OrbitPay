    <!-- Onboarding Screen -->
    <string name="onboarding_title">Merchant setup wizard</string>
    <string name="onboarding_step_counter">Step %1$d of %2$d</string>
    <string name="onboarding_next_step">Next step</string>
    <string name="onboarding_finish_launch">Finish &amp; launch</string>
    <string name="onboarding_step1_title">1. Grant SMS permissions</string>
    <string name="onboarding_step1_subtitle">Required to capture incoming bKash &amp; Nagad messages</string>
    <string name="onboarding_step1_desc">ORBIT Pay listens for official MFS transaction SMS from bKash, NAGAD, 16216, upay, and CellFin. Only TrxID, amount, and sender phone number are extracted.</string>
    <string name="onboarding_step1_action">Grant SMS &amp; notification permissions</string>
    <string name="onboarding_step2_title">2. Notification listener access</string>
    <string name="onboarding_step2_subtitle">Sub-second push ingestion fallback</string>
    <string name="onboarding_step2_desc">During high-traffic flash sales, telecom SMS can lag by up to 2 minutes. Notification listener allows ORBIT Pay to verify payments directly from bKash or Nagad app notifications.</string>
    <string name="onboarding_step2_action">Open notification access settings</string>
    <string name="onboarding_step3_title">3. Disable battery optimization</string>
    <string name="onboarding_step3_subtitle">Prevent Android OS from putting ORBIT to sleep</string>
    <string name="onboarding_step3_desc">Aggressive OS battery savers (MIUI, ColorOS, OneUI) put background apps to sleep. Exempting ORBIT Pay from battery optimization ensures continuous payment verification.</string>
    <string name="onboarding_step3_action">Disable battery optimization</string>
    <string name="onboarding_step4_title">4. Android 13/14 restricted settings</string>
    <string name="onboarding_step4_subtitle">Unblock sideloaded APK permissions</string>
    <string name="onboarding_step4_desc">On Android 13 and 14, sideloaded companion apps may have Notification Access grayed out with \'Restricted setting\'.\n\nTo unblock:\n1. Tap \'Open app info\' below\n2. Tap the 3 dots in the top-right corner\n3. Tap \'Allow restricted settings\'\n4. Verify with device PIN or fingerprint.</string>
    <string name="onboarding_step4_action">Open app info (allow restricted settings)</string>
    <string name="onboarding_step5_title">5. SMS spoof protection &amp; inbox scan</string>
    <string name="onboarding_step5_subtitle">How ORBIT Pay blocks fake payment SMS</string>
    <string name="onboarding_step5_desc">Every payment message is verified against strict sender-trust rules before it can confirm any storefront order.</string>
    <string name="onboarding_step5_spoof_title">Official MFS senders only</string>
    <string name="onboarding_step5_spoof_desc">Only official MFS sender IDs (bKash, NAGAD, 16216, Rocket, upay, CellFin, IBBL) and verified MFS apps are accepted. Personal 01XXXXXXXXX phone numbers and mismatched providers are blocked automatically.</string>
    <string name="onboarding_step5_readsms_title">READ_SMS for missed payments</string>
    <string name="onboarding_step5_readsms_desc">READ_SMS lets ORBIT Pay scan your recent SMS inbox (up to 72 hours) after login or network outages so missed payments are recovered safely. Personal messages are never uploaded.</string>

