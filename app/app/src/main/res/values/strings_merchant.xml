    <!-- Merchant Onboarding: Step 1 (How ORBIT Pay Works) -->
    <string name="onboarding_how_title">Welcome to ORBIT Pay</string>
    <string name="onboarding_how_subtitle">Automatic payment verification for your business</string>
    <string name="onboarding_how_desc">You do not need any technical knowledge. Our team sets up your website connection for you — just keep this phone connected to your store SIM.</string>
    <string name="onboarding_how_point1_title">1. Customer pays you</string>
    <string name="onboarding_how_point1_desc">Customers send money to your bKash, Nagad, Rocket, Upay, or CellFin number from your website or a Payment Link.</string>
    <string name="onboarding_how_point2_title">2. Phone confirms automatically</string>
    <string name="onboarding_how_point2_desc">As soon as the payment SMS reaches your phone, ORBIT Pay checks the TrxID and exact amount in 1–2 seconds.</string>
    <string name="onboarding_how_point3_title">3. Orders update in real time</string>
    <string name="onboarding_how_point3_desc">Your order status is marked Paid automatically — no manual screenshot checking needed unless you choose to review.</string>

    <!-- Merchant Onboarding: Step 2 (Install & Google Play Protect Hurdles) -->
    <string name="onboarding_hurdles_title">Overcoming Android Setup Hurdles</string>
    <string name="onboarding_hurdles_subtitle">Quick fixes if your phone blocks permissions or warnings appear</string>
    <string name="onboarding_hurdles_desc">Because this app connects directly to your business SIM SMS, Android and Google Play Protect show extra safety prompts. Follow these 3 quick steps:</string>
    <string name="onboarding_hurdle_play_title">Google Play Protect warning</string>
    <string name="onboarding_hurdle_play_desc">If you see "Blocked by Play Protect" or "Unsafe app" while installing or updating, tap "More details" and then tap "Install anyway". This is normal for private business companion apps.</string>
    <string name="onboarding_hurdle_restricted_title">"Restricted setting" on Android 13 / 14 / 15</string>
    <string name="onboarding_hurdle_restricted_desc">If Notification Access looks greyed out, tap "Open App Info" below -> tap the 3 dots in the top-right corner -> tap "Allow restricted settings" -> verify with your phone PIN or fingerprint.</string>
    <string name="onboarding_hurdle_battery_title">Phone sleeping in the background</string>
    <string name="onboarding_hurdle_battery_desc">Xiaomi, Oppo, Vivo, Realme, and Samsung phones pause background apps to save battery. Tap "Battery Unrestricted" below so customer payments are never delayed.</string>
    <string name="onboarding_btn_app_info">Open App Info</string>
    <string name="onboarding_btn_battery">Battery Unrestricted</string>
    <string name="onboarding_btn_notif_access">Notification Access</string>

    <!-- Merchant Onboarding: Step 3 (Permissions & Why) -->
    <string name="onboarding_perms_title">Permissions &amp; Why We Need Them</string>
    <string name="onboarding_perms_subtitle">Only what is needed to verify customer payments</string>
    <string name="onboarding_perms_desc">ORBIT Pay respects your privacy. Personal chats, photos, contacts, and OTP codes are never uploaded.</string>
    <string name="onboarding_perm_sms_title">Read &amp; Receive SMS</string>
    <string name="onboarding_perm_sms_reason">Reads only official bKash, Nagad, Rocket, Upay, and CellFin payment confirmation SMS so customer orders confirm automatically.</string>
    <string name="onboarding_perm_listener_title">Notification Access</string>
    <string name="onboarding_perm_listener_reason">Instant backup check from bKash or Nagad app notifications if your mobile operator delays an SMS.</string>
    <string name="onboarding_perm_sim_title">SIM Info &amp; Alerts</string>
    <string name="onboarding_perm_sim_reason">Identifies which SIM received the payment (for monthly SIM limits) and sends you instant phone alerts when a payment needs review.</string>
    <string name="onboarding_perm_battery_title">Unrestricted Background Battery</string>
    <string name="onboarding_perm_battery_reason">Keeps payment checking running smoothly 24/7, even when your phone screen is locked.</string>
    <string name="onboarding_perm_allowed">Allowed</string>
    <string name="onboarding_perm_needed">Tap below</string>

