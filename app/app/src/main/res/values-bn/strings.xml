    <string name="onboarding_finish_launch">সম্পন্ন করে চালু করুন</string>
    <string name="onboarding_step1_title">১. এসএমএস অনুমতি দিন</string>
    <string name="onboarding_step1_subtitle">বিকাশ ও নগদের ইনকামিং মেসেজ সংগ্রহের জন্য প্রয়োজন</string>
    <string name="onboarding_step1_desc">ORBIT Pay শুধুমাত্র বিকাশ, নগদ, 16216, উপায় ও সেলফিনের অফিসিয়াল লেনদেনের এসএমএস পড়ে। শুধুমাত্র TrxID, টাকার পরিমাণ ও প্রেরকের নম্বর সংগ্রহ করা হয়।</string>
    <string name="onboarding_step1_action">এসএমএস ও নোটিফিকেশন অনুমতি দিন</string>
    <string name="onboarding_step2_title">২. নোটিফিকেশন লিসেনার অ্যাক্সেস</string>
    <string name="onboarding_step2_subtitle">তাৎক্ষণিক পুশ যাচাইয়ের বিকল্প ব্যবস্থা</string>
    <string name="onboarding_step2_desc">বেশি ট্রাফিকের সময় টেলিকম এসএমএস আসতে ২ মিনিট পর্যন্ত দেরি হতে পারে। নোটিফিকেশন লিসেনার চালু থাকলে বিকাশ বা নগদ অ্যাপের নোটিফিকেশন থেকেই পেমেন্ট যাচাই করা যায়।</string>
    <string name="onboarding_step2_action">নোটিফিকেশন অ্যাক্সেস সেটিংস খুলুন</string>
    <string name="onboarding_step3_title">৩. ব্যাটারি অপটিমাইজেশন বন্ধ করুন</string>
    <string name="onboarding_step3_subtitle">অ্যান্ড্রয়েড যেন ব্যাকগ্রাউন্ডে ORBIT বন্ধ না করে</string>
    <string name="onboarding_step3_desc">ফোনের ব্যাটারি সেভার (MIUI, ColorOS, OneUI) ব্যাকগ্রাউন্ড অ্যাপ স্লিপ করে দেয়। ব্যাটারি অপটিমাইজেশন থেকে অব্যাহতি দিলে পেমেন্ট যাচাই নিরবচ্ছিন্নভাবে চলবে।</string>
    <string name="onboarding_step3_action">ব্যাটারি অপটিমাইজেশন বন্ধ করুন</string>
    <string name="onboarding_step4_title">৪. অ্যান্ড্রয়েড ১৩/১৪ রেস্ট্রিক্টেড সেটিংস</string>
    <string name="onboarding_step4_subtitle">সাইডলোড করা APK-এর অনুমতি আনলক করুন</string>
    <string name="onboarding_step4_desc">অ্যান্ড্রয়েড ১৩ ও ১৪ সংস্করণে সাইডলোড করা অ্যাপের নোটিফিকেশন অ্যাক্সেস \'Restricted setting\' হিসেবে বন্ধ থাকতে পারে।\n\nআনলক করতে:\n১. নিচের \'অ্যাপ তথ্য খুলুন\' বোতামে ট্যাপ করুন\n২. উপরে ডানদিকের ৩-ডট মেনুতে ট্যাপ করুন\n৩. \'Allow restricted settings\' নির্বাচন করুন\n৪. ডিভাইস পিন বা ফিঙ্গারপ্রিন্ট দিয়ে নিশ্চিত করুন।</string>
    <string name="onboarding_step4_action">অ্যাপ তথ্য খুলুন (রেস্ট্রিক্টেড সেটিংস অনুমোদন)</string>
    <string name="onboarding_step5_title">৫. এসএমএস স্পুফ সুরক্ষা ও ইনবক্স স্ক্যান</string>
    <string name="onboarding_step5_subtitle">ভুয়া পেমেন্ট এসএমএস থেকে ORBIT Pay যেভাবে সুরক্ষা দেয়</string>
    <string name="onboarding_step5_desc">প্রতিটি পেমেন্ট মেসেজ অর্ডার নিশ্চিত করার আগে কঠোর প্রেরক-বিশ্বাসযোগ্যতা নিয়মে যাচাই করা হয়।</string>
    <string name="onboarding_step5_spoof_title">শুধুমাত্র অফিসিয়াল এমএফএস প্রেরক</string>
    <string name="onboarding_step5_spoof_desc">শুধুমাত্র অফিসিয়াল এমএফএস প্রেরক আইডি (bKash, NAGAD, 16216, Rocket, upay, CellFin, IBBL) ও যাচাইকৃত এমএফএস অ্যাপ গ্রহণ করা হয়। ব্যক্তিগত 01XXXXXXXXX ফোন নম্বর বা অমিল প্রোভাইডারের মেসেজ স্বয়ংক্রিয়ভাবে ব্লক হয়।</string>
    <string name="onboarding_step5_readsms_title">হারিয়ে যাওয়া পেমেন্টের জন্য READ_SMS</string>
    <string name="onboarding_step5_readsms_desc">লগইন বা নেটওয়ার্ক বিচ্ছিন্নতার পর সাম্প্রতিক ইনবক্স (৭২ ঘণ্টা পর্যন্ত) স্ক্যান করে বাদ পড়া পেমেন্ট উদ্ধারের জন্য READ_SMS প্রয়োজন। ব্যক্তিগত মেসেজ কখনোই আপলোড করা হয় না।</string>

