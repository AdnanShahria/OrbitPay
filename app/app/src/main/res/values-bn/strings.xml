    <string name="onboarding_step2_action">নোটিফিকেশন অ্যাক্সেস সেটিংস খুলুন</string>
    <string name="onboarding_step3_title">৩. ব্যাকগ্রাউন্ডে অ্যাপ চালু রাখুন</string>
    <string name="onboarding_step3_subtitle">ফোন লক থাকলেও যেন পেমেন্ট চেক বন্ধ না হয়</string>
    <string name="onboarding_step3_desc">ফোনের ব্যাটারি সেভার ব্যাকগ্রাউন্ড অ্যাপ বন্ধ করে দেয়। ব্যাটারি অপটিমাইজেশন থেকে ছাড় দিলে ২৪ ঘণ্টা পেমেন্ট যাচাই নিরবচ্ছিন্নভাবে চলবে।</string>
    <string name="onboarding_step3_action">ব্যাটারি অপটিমাইজেশন বন্ধ করুন</string>
    <string name="onboarding_step4_title">৪. অ্যান্ড্রয়েড ১৩/১৪/১৫ রেস্ট্রিক্টেড সেটিংস</string>
    <string name="onboarding_step4_subtitle">অনুমতি অপশন বন্ধ থাকলে আনলক করুন</string>
    <string name="onboarding_step4_desc">নতুন অ্যান্ড্রয়েড ফোনে নোটিফিকেশন অ্যাক্সেস \'Restricted setting\' হিসেবে বন্ধ থাকতে পারে।\n\nআনলক করতে:\n১. নিচের \'অ্যাপ তথ্য খুলুন\' বোতামে চাপ দিন\n২. উপরে ডানদিকের ৩-ডট মেনুতে চাপ দিন\n৩. \'Allow restricted settings\' নির্বাচন করুন\n৪. ফোনের পিন বা ফিঙ্গারপ্রিন্ট দিয়ে নিশ্চিত করুন।</string>
    <string name="onboarding_step4_action">অ্যাপ তথ্য খুলুন</string>
    <string name="onboarding_step5_title">৫. ভুয়া এসএমএস সুরক্ষা ও প্রস্তুত</string>
    <string name="onboarding_step5_subtitle">ভুয়া মেসেজ থেকে আপনার ব্যবসা যেভাবে সুরক্ষিত থাকে</string>
    <string name="onboarding_step5_desc">প্রতিটি পেমেন্ট মেসেজ অফিশিয়াল প্রেরক নিয়মে যাচাই হওয়ার পরই অর্ডার কনফার্ম হয়।</string>
    <string name="onboarding_step5_spoof_title">শুধুমাত্র অফিশিয়াল MFS প্রেরক</string>
    <string name="onboarding_step5_spoof_desc">শুধুমাত্র অফিশিয়াল বিকাশ, নগদ, 16216, রকেট, উপায়, সেলফিন ও IBBL অ্যালার্ট গ্রহণ করা হয়। ব্যক্তিগত 01XXXXXXXXX নম্বর থেকে পাঠানো ভুয়া মেসেজ স্বয়ংক্রিয়ভাবে ব্লক হয়।</string>
    <string name="onboarding_step5_readsms_title">বাদ পড়া পেমেন্ট উদ্ধার (৭২ ঘণ্টা)</string>
    <string name="onboarding_step5_readsms_desc">ইন্টারনেট বন্ধ থাকলে বা নতুন লগইন করার পর বিগত ৭২ ঘণ্টার অফিশিয়াল পেমেন্ট এসএমএস পরীক্ষা করে বাদ পড়া পেমেন্ট উদ্ধার করা হয়। ব্যক্তিগত মেসেজে হাত দেওয়া হয় না।</string>

