    <string name="onboarding_step1_desc">ORBIT Pay শুধু বিকাশ, নগদ, 16216, উপায় ও সেলফিনের অফিশিয়াল লেনদেনের এসএমএস পড়ে। আপনার ব্যক্তিগত কোনো মেসেজ আপলোড করা হয় না।</string>
    <string name="onboarding_step1_action">এসএমএস, সিম ও নোটিফিকেশন অনুমতি দিন</string>
