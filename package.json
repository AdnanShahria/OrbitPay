{
  "name": "orbit-payment-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ORBIT Payment Hub - Multi-tenant 3-party MFS verification SaaS",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node scripts/dev.mjs",
    "dev:full": "node scripts/dev.mjs",
    "dev:open": "node scripts/dev.mjs --open",
    "dev:realtime": "node scripts/dev.mjs --realtime",
    "dev:backend": "wrangler dev --port 8787",
    "dev:frontend": "npm --workspace=frontend run dev",
    "web": "node scripts/launch.mjs web",
    "admin": "node scripts/launch.mjs admin",
    "checkout": "node scripts/launch.mjs checkout",
    "app": "node scripts/launch.mjs android",
    "app:menu": "node scripts/app-cli.mjs",
    "app:release": "node scripts/app-cli.mjs release",
    "cli": "node scripts/app-cli.mjs",
    "app:emu": "node scripts/launch.mjs android --emulator",
    "app:studio": "node scripts/launch.mjs studio",
    "simulate": "node scripts/simulate-realtime.mjs",
    "verify:orbitmail": "node scripts/verify-orbitmail.mjs",
    "check:app": "node scripts/app-check.mjs",
    "check:app:security": "node scripts/app-check.mjs --security",
    "check:app:ci": "node scripts/app-check.mjs --ci",
    "build:frontend": "npm --workspace=frontend run build",
    "build:backend": "npm --workspace=backend run build",
    "build": "npm --workspace=frontend run build && npm --workspace=backend run build",
    "deploy": "npm run build && npx wrangler deploy",
    "db:generate": "npm --workspace=backend run db:generate",
    "db:migrate": "npm --workspace=backend run db:migrate"
  },
  "keywords": [
    "orbit-pay",
    "mfs",
    "bkash",
    "nagad",
    "cloudflare-pages",
    "hono",
    "react19",
    "android"
  ],
  "author": "ORBIT SaaS",
  "license": "UNLICENSED"
}
